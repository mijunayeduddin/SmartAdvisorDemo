  "description": "SmartAdvisor Backend Engine (Express, WebSockets, PostgreSQL, DAG Solver)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --verbose",
